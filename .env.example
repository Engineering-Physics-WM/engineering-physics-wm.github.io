# Public build/runtime configuration
# Leave empty when the frontend and API are deployed together on Vercel.
VITE_API_BASE_URL=
APP_ORIGIN=

# Server-only Vercel/Neon configuration. Never prefix secrets with VITE_.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Used only by scripts/db:migrate-supabase during the one-time transfer.
SUPABASE_DB_URL=postgresql://user:password@host/postgres?sslmode=require
SESSION_SECRET=replace_with_a_random_string_at_least_32_characters
INSTRUCTOR_EMAIL=rxyan2@wm.edu
INSTRUCTOR_NAME=Ran Yang
INSTRUCTOR_PASSWORD_HASH=replace_with_bcrypt_hash

# Optional AI email rewrite configuration
AI_EMAIL_PROVIDER=gemini
GEMINI_API_KEY=replace_with_provider_key
AI_EMAIL_MODEL=gemini-2.5-flash
